# ─────────────────────────────────────────────────────────────────────────────
# Phronesis Workspace Environment Configuration Template (.env.example)
# Copy this file to `.env` or `backend/.env`. NEVER commit real keys to Git!
# ─────────────────────────────────────────────────────────────────────────────

# Active LLM Provider: "gemini" | "openai" | "anthropic" | "mock"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Generic API Key
LLM_API_KEY=

# Provider-Specific API Keys (Optional overrides for multi-model switching)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Server & Security Configuration
HOST=0.0.0.0
PORT=8010
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,http://localhost:5173,http://127.0.0.1:5173
